        "about_text": {
          "type": "text",
          "settings": {
            "text": "<p>Fashion has never been just about clothing for Cecilia. It has always been about courage, identity, and telling stories without saying a word.</p><p>S24 By Cecilia began in Nigeria in 2014 and was rebuilt in Canada — blending African heritage with modern elegance so every woman feels confident, unforgettable, and uniquely herself.</p>",
            "text_style": "body"
          }
        },
        "about_button": {
          "type": "button",
          "settings": {
            "button_label": "Read her story",
            "button_link": "shopify://pages/about",
            "button_style_secondary": false
          }
        }
      },
