          "settings": {
            "heading": "Heritage, made modern",
            "text": "African print and craftsmanship cut for the way you live now — not costume, not trend-chasing. Everyday luxury with a story."
          }
        },
        "pillar_2": {
          "type": "pillar",
          "settings": {
            "heading": "Made to fit you",
            "text": "Standard sizes plus custom when the rack is not enough. If your size is not listed, we still have a way to dress you."
          }
        },
        "pillar_3": {
          "type": "pillar",
          "settings": {
            "heading": "Designed in Canada",
            "text": "A brand rebuilt with care after relocation — small-batch pieces, thoughtful details, and clothing meant to be worn and remembered."
          }
        }
      },
