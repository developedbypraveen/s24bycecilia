{% comment %}
  Homepage product grid — 4×2 (8 products), mixed from multiple collections.
  First card: auto-rotating images. Other cards: secondary image on hover.
{% endcomment %}

{{ 'component-card.css' | asset_url | stylesheet_tag }}
{{ 'component-price.css' | asset_url | stylesheet_tag }}
{{ 'template-collection.css' | asset_url | stylesheet_tag }}

{%- style -%}
  .s24-crow-{{ section.id }} {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round }}px;
  }
  @media screen and (min-width: 750px) {
    .s24-crow-{{ section.id }} {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }
{%- endstyle -%}

{%- liquid
  assign limit = section.settings.products_to_show | default: 8
  assign more_url = section.settings.button_link
  if more_url == blank
    assign more_url = routes.all_products_collection_url
  endif

  assign col_a = section.settings.collection_1
  assign col_b = section.settings.collection_2
  assign col_c = section.settings.collection_3
  assign col_d = section.settings.collection_4
  assign col_e = section.settings.collection_5
  assign picked = section.settings.product_list
-%}

<section class="s24-crow s24-crow--grid s24-crow-{{ section.id }}">
  <div class="page-width">
    <div class="s24-crow__head">
      <div class="s24-crow__copy">
        {%- if section.settings.eyebrow != blank -%}
          <p class="s24-crow__eyebrow">{{ section.settings.eyebrow | escape }}</p>
        {%- endif -%}
        {%- if section.settings.title != blank -%}
          <h2 class="s24-crow__title">{{ section.settings.title | escape }}</h2>
        {%- endif -%}
        {%- if section.settings.text != blank -%}
          <p class="s24-crow__text">{{ section.settings.text | escape }}</p>
        {%- endif -%}
      </div>
      {%- if section.settings.button_label != blank -%}
        <a class="s24-crow__more" href="{{ more_url }}">
          {{ section.settings.button_label | escape }}
        </a>
      {%- endif -%}
    </div>

    <ul class="s24-crow__grid" role="list">
      {%- if picked != blank and picked.size > 0 -%}
        {%- for product in picked limit: limit -%}
          <li class="s24-crow__item{% if forloop.first %} s24-crow__item--auto{% endif %}">
            {%- if forloop.first -%}
              {% render 's24-card-auto', card_product: product, section_id: section.id %}
            {%- else -%}
              {% render 'card-product',
                card_product: product,
                media_aspect_ratio: 'portrait',
                show_secondary_image: true,
                show_vendor: false,
                show_rating: false,
                section_id: section.id,
                lazy_load: true,
                product_view_context: 'collection'
              %}
            {%- endif -%}
          </li>
        {%- endfor -%}
      {%- else -%}
        {%- liquid
          assign shown = 0
          assign used_ids = '|'
        -%}
        {%- for pass in (0..11) -%}
          {%- if shown >= limit -%}{% break %}{%- endif -%}
          {%- for col in (1..5) -%}
            {%- if shown >= limit -%}{% break %}{%- endif -%}
            {%- liquid
              case col
                when 1
                  assign source = col_a
                when 2
                  assign source = col_b
                when 3
                  assign source = col_c
                when 4
                  assign source = col_d
                when 5
                  assign source = col_e
              endcase
              assign product = blank
              if source != blank and source.products_count > pass
                assign product = source.products[pass]
              endif
            -%}
            {%- if product != blank -%}
              {%- assign id_token = product.id | append: '|' -%}
              {%- unless used_ids contains id_token -%}
                {%- assign used_ids = used_ids | append: id_token -%}
                {%- assign is_first = false -%}
                {%- if shown == 0 -%}
                  {%- assign is_first = true -%}
                {%- endif -%}
                {%- assign shown = shown | plus: 1 -%}
                <li class="s24-crow__item{% if is_first %} s24-crow__item--auto{% endif %}">
                  {%- if is_first -%}
                    {% render 's24-card-auto', card_product: product, section_id: section.id %}
                  {%- else -%}
                    {% render 'card-product',
                      card_product: product,
                      media_aspect_ratio: 'portrait',
                      show_secondary_image: true,
                      show_vendor: false,
                      show_rating: false,
                      section_id: section.id,
                      lazy_load: true,
                      product_view_context: 'collection'
                    %}
                  {%- endif -%}
                </li>
              {%- endunless -%}
            {%- endif -%}
          {%- endfor -%}
        {%- endfor -%}

        {%- if shown == 0 -%}
          {%- for i in (1..8) -%}
            <li class="s24-crow__item">
              {% render 'card-product', media_aspect_ratio: 'portrait', section_id: section.id, show_secondary_image: true %}
            </li>
          {%- endfor -%}
        {%- endif -%}
      {%- endif -%}
    </ul>
  </div>
</section>

{% schema %}
{
  "name": "S24 product grid",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Heading",
      "default": "Shop the season"
    },
    {
      "type": "textarea",
      "id": "text",
      "label": "Supporting text"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Link label",
      "default": "See all"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Link URL"
    },
    {
      "type": "range",
      "id": "products_to_show",
      "min": 4,
      "max": 12,
      "step": 1,
      "label": "Products to show",
      "default": 8
    },
    {
      "type": "header",
      "content": "Mixed collections"
    },
    {
      "type": "paragraph",
      "content": "Products are mixed round-robin from these collections (8 total, 4 per row). First product auto-rotates images; others swap on hover."
    },
    {
      "type": "collection",
      "id": "collection_1",
      "label": "Collection 1"
    },
    {
      "type": "collection",
      "id": "collection_2",
      "label": "Collection 2"
    },
    {
      "type": "collection",
      "id": "collection_3",
      "label": "Collection 3"
    },
    {
      "type": "collection",
      "id": "collection_4",
      "label": "Collection 4"
    },
    {
      "type": "collection",
      "id": "collection_5",
      "label": "Collection 5"
    },
    {
      "type": "product_list",
      "id": "product_list",
      "label": "Or choose products manually",
      "limit": 12
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Padding top",
      "default": 48
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Padding bottom",
      "default": 56
    }
  ],
  "presets": [
    {
      "name": "S24 product grid"
    }
  ]
}
{% endschema %}
