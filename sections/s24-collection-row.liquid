{% comment %}
  Homepage product grid — 4×2 (8 products), mixed from multiple collections.
  First card: auto-rotating images. Other cards: secondary image on hover.
{% endcomment %}

{{ 'component-card.css' | asset_url | stylesheet_tag }}
{{ 'component-price.css' | asset_url | stylesheet_tag }}
{{ 'template-collection.css' | asset_url | stylesheet_tag }}

{%- style -%}
  .s24-crow-{{ section.id }} {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round }}px;
  }
  @media screen and (min-width: 750px) {
    .s24-crow-{{ section.id }} {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }
{%- endstyle -%}

{%- liquid
  assign limit = section.settings.products_to_show | default: 8
  assign more_url = section.settings.button_link
  if more_url == blank
    assign more_url = routes.all_products_collection_url
  endif

  assign col_a = section.settings.collection_1
  assign col_b = section.settings.collection_2
  assign col_c = section.settings.collection_3
  assign col_d = section.settings.collection_4
  assign col_e = section.settings.collection_5
  assign picked = section.settings.product_list
  assign sort_order = section.settings.sort_by_price | default: 'price-asc'

  assign crow_products = ''
  if picked != blank and picked.size > 0
    assign crow_products = picked
  else
    if col_a != blank
      assign crow_products = col_a.products
    endif
    if col_b != blank
      if crow_products == blank
        assign crow_products = col_b.products
      else
        assign crow_products = crow_products | concat: col_b.products
      endif
    endif
    if col_c != blank
      if crow_products == blank
        assign crow_products = col_c.products
      else
        assign crow_products = crow_products | concat: col_c.products
      endif
    endif
    if col_d != blank
      if crow_products == blank
        assign crow_products = col_d.products
      else
        assign crow_products = crow_products | concat: col_d.products
      endif
    endif
    if col_e != blank
      if crow_products == blank
        assign crow_products = col_e.products
      else
        assign crow_products = crow_products | concat: col_e.products
      endif
    endif
  endif

  if crow_products != blank
    if sort_order == 'price-desc'
      assign crow_products = crow_products | sort: 'price' | reverse
    else
      assign crow_products = crow_products | sort: 'price'
    endif
  endif
-%}

<section class="s24-crow s24-crow--grid s24-crow-{{ section.id }}">
  <div class="page-width">
    <div class="s24-crow__head">
      <div class="s24-crow__copy">
        {%- if section.settings.eyebrow != blank -%}
          <p class="s24-crow__eyebrow">{{ section.settings.eyebrow | escape }}</p>
        {%- endif -%}
        {%- if section.settings.title != blank -%}
          <h2 class="s24-crow__title">{{ section.settings.title | escape }}</h2>
        {%- endif -%}
        {%- if section.settings.text != blank -%}
          <p class="s24-crow__text">{{ section.settings.text | escape }}</p>
        {%- endif -%}
      </div>
      {%- if section.settings.button_label != blank -%}
        <a class="s24-crow__more" href="{{ more_url }}">
          {{ section.settings.button_label | escape }}
        </a>
      {%- endif -%}
    </div>

    <ul class="s24-crow__grid" role="list">
      {%- if crow_products != blank and crow_products.size > 0 -%}
        {%- liquid
          assign shown = 0
          assign used_ids = '|'
        -%}
        {%- for product in crow_products -%}
          {%- if shown >= limit -%}{% break %}{%- endif -%}
          {%- assign id_token = product.id | append: '|' -%}
          {%- unless used_ids contains id_token -%}
            {%- assign used_ids = used_ids | append: id_token -%}
            {%- assign is_first = false -%}
            {%- if shown == 0 -%}
              {%- assign is_first = true -%}
            {%- endif -%}
            {%- assign shown = shown | plus: 1 -%}
            <li class="s24-crow__item{% if is_first %} s24-crow__item--auto{% endif %}">
              {%- if is_first -%}
                {% render 's24-card-auto', card_product: product, section_id: section.id %}
              {%- else -%}
                {% render 'card-product',
                  card_product: product,
                  media_aspect_ratio: 'portrait',
                  show_secondary_image: true,
                  show_vendor: false,
                  show_rating: false,
                  section_id: section.id,
                  lazy_load: true,
                  product_view_context: 'collection'
                %}
              {%- endif -%}
            </li>
          {%- endunless -%}
        {%- endfor -%}
      {%- else -%}
        {%- for i in (1..8) -%}
          <li class="s24-crow__item">
            {% render 'card-product', media_aspect_ratio: 'portrait', section_id: section.id, show_secondary_image: true %}
          </li>
        {%- endfor -%}
      {%- endif -%}
    </ul>
  </div>
</section>

{% schema %}
{
  "name": "S24 product grid",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Heading",
      "default": "Shop the season"
    },
    {
      "type": "textarea",
      "id": "text",
      "label": "Supporting text"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Link label",
      "default": "See all"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Link URL"
    },
    {
      "type": "range",
      "id": "products_to_show",
      "min": 4,
      "max": 12,
      "step": 1,
      "label": "Products to show",
      "default": 8
    },
    {
      "type": "select",
      "id": "sort_by_price",
      "label": "Sort products",
      "options": [
        { "value": "price-asc", "label": "Price: low to high (group same price)" },
        { "value": "price-desc", "label": "Price: high to low" }
      ],
      "default": "price-asc",
      "info": "Products with the same price are shown next to each other."
    },
    {
      "type": "header",
      "content": "Mixed collections"
    },
    {
      "type": "paragraph",
      "content": "Products are taken from these collections, sorted by price, then shown (4 per row). First product auto-rotates images; others swap on hover."
    },
    {
      "type": "collection",
      "id": "collection_1",
      "label": "Collection 1"
    },
    {
      "type": "collection",
      "id": "collection_2",
      "label": "Collection 2"
    },
    {
      "type": "collection",
      "id": "collection_3",
      "label": "Collection 3"
    },
    {
      "type": "collection",
      "id": "collection_4",
      "label": "Collection 4"
    },
    {
      "type": "collection",
      "id": "collection_5",
      "label": "Collection 5"
    },
    {
      "type": "product_list",
      "id": "product_list",
      "label": "Or choose products manually",
      "limit": 12,
      "info": "If set, these products are used instead of collections, still sorted by price."
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Padding top",
      "default": 48
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Padding bottom",
      "default": 56
    }
  ],
  "presets": [
    {
      "name": "S24 product grid"
    }
  ]
}
{% endschema %}
