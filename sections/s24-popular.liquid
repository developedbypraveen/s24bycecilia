{% comment %}
  Most popular products — title left, tabs right, 5-up product slider.
{% endcomment %}

{{ 'component-card.css' | asset_url | stylesheet_tag }}
{{ 'component-price.css' | asset_url | stylesheet_tag }}

{%- style -%}
  .s24-pop-{{ section.id }} {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round }}px;
  }
  @media screen and (min-width: 750px) {
    .s24-pop-{{ section.id }} {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }
{%- endstyle -%}

<section class="s24-pop s24-pop-{{ section.id }}" data-s24-popular>
  <div class="page-width">
    <div class="s24-pop__head">
      {%- if section.settings.title != blank -%}
        <h2 class="s24-pop__title">{{ section.settings.title | escape }}</h2>
      {%- endif -%}

      {%- if section.blocks.size > 0 -%}
        <div class="s24-pop__tabs" role="tablist" aria-label="{{ section.settings.title | escape }}">
          {%- for block in section.blocks -%}
            <button
              type="button"
              class="s24-pop__tab{% if forloop.first %} is-active{% endif %}"
              role="tab"
              id="PopTab-{{ section.id }}-{{ block.id }}"
              aria-selected="{% if forloop.first %}true{% else %}false{% endif %}"
              aria-controls="PopPanel-{{ section.id }}-{{ block.id }}"
              data-s24-pop-tab
              {{ block.shopify_attributes }}
            >
              {{ block.settings.label | escape }}
            </button>
          {%- endfor -%}
        </div>
      {%- endif -%}
    </div>

    <div class="s24-pop__body">
      {%- for block in section.blocks -%}
        {%- liquid
          assign tab_collection = block.settings.collection
          assign tab_products = block.settings.product_list
          assign limit = section.settings.products_to_show | default: 10
        -%}
        <div
          class="s24-pop__panel{% if forloop.first %} is-active{% endif %}"
          role="tabpanel"
          id="PopPanel-{{ section.id }}-{{ block.id }}"
          aria-labelledby="PopTab-{{ section.id }}-{{ block.id }}"
          data-s24-pop-panel
          {% unless forloop.first %}hidden{% endunless %}
        >
          <div class="s24-pop__viewport">
            <ul class="s24-pop__track" role="list" data-s24-pop-track>
              {%- if tab_products != blank and tab_products.size > 0 -%}
                {%- for product in tab_products limit: limit -%}
                  <li class="s24-pop__item" data-s24-pop-item>
                    {%- if forloop.index == 2 -%}
                      {% render 's24-card-auto', card_product: product, section_id: section.id %}
                    {%- else -%}
                      {% render 'card-product',
                        card_product: product,
                        media_aspect_ratio: 'portrait',
                        show_secondary_image: true,
                        show_vendor: false,
                        show_rating: false,
                        section_id: section.id,
                        product_view_context: 'collection'
                      %}
                    {%- endif -%}
                  </li>
                {%- endfor -%}
              {%- elsif tab_collection != blank -%}
                {%- for product in tab_collection.products limit: limit -%}
                  <li class="s24-pop__item" data-s24-pop-item>
                    {%- if forloop.index == 2 -%}
                      {% render 's24-card-auto', card_product: product, section_id: section.id %}
                    {%- else -%}
                      {% render 'card-product',
                        card_product: product,
                        media_aspect_ratio: 'portrait',
                        show_secondary_image: true,
                        show_vendor: false,
                        show_rating: false,
                        section_id: section.id,
                        product_view_context: 'collection'
                      %}
                    {%- endif -%}
                  </li>
                {%- endfor -%}
              {%- else -%}
                {%- for i in (1..5) -%}
                  <li class="s24-pop__item" data-s24-pop-item>
                    {% render 'card-product', media_aspect_ratio: 'portrait', section_id: section.id, show_secondary_image: true %}
                  </li>
                {%- endfor -%}
              {%- endif -%}
            </ul>
          </div>
        </div>
      {%- endfor -%}

      <div class="s24-pop__nav" aria-label="Product slider">
        <button type="button" class="s24-pop__arrow" data-s24-pop-prev aria-label="Previous">
          <svg width="14" height="14" viewBox="0 0 14 14" fill="none" aria-hidden="true">
            <path d="M9 2.5L4.5 7L9 11.5" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
        </button>
        <button type="button" class="s24-pop__arrow" data-s24-pop-next aria-label="Next">
          <svg width="14" height="14" viewBox="0 0 14 14" fill="none" aria-hidden="true">
            <path d="M5 2.5L9.5 7L5 11.5" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
        </button>
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "S24 popular products",
  "tag": "section",
  "class": "section",
  "max_blocks": 6,
  "disabled_on": { "groups": ["header", "footer"] },
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "Heading",
      "default": "Most popular products"
    },
    {
      "type": "range",
      "id": "products_to_show",
      "min": 5,
      "max": 16,
      "step": 1,
      "label": "Products per tab",
      "default": 10
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Padding top",
      "default": 56
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Padding bottom",
      "default": 56
    }
  ],
  "blocks": [
    {
      "type": "tab",
      "name": "Tab",
      "settings": [
        {
          "type": "text",
          "id": "label",
          "label": "Tab label",
          "default": "Ready-to-Wear"
        },
        {
          "type": "collection",
          "id": "collection",
          "label": "Collection"
        },
        {
          "type": "product_list",
          "id": "product_list",
          "label": "Or choose products",
          "limit": 16
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "S24 popular products",
      "blocks": [
        { "type": "tab", "settings": { "label": "Ready-to-Wear" } },
        { "type": "tab", "settings": { "label": "Tops" } },
        { "type": "tab", "settings": { "label": "Two-Piece Sets" } }
      ]
    }
  ]
}
{% endschema %}
