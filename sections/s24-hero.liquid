{% comment %}
  S24 two-column hero slider. Schema matches other live S24 sections.
{% endcomment %}

<section class="s24-hero s24-hero--slider" data-s24-hero data-interval="6000">
  {%- for block in section.blocks -%}
    <article class="s24-hero__slide{% if forloop.first %} is-active{% endif %}" data-s24-hero-slide {{ block.shopify_attributes }}>
      <div class="s24-hero__copy">
        {%- if block.settings.kicker != blank -%}
          <p class="s24-hero__kicker">{{ block.settings.kicker | escape }}</p>
        {%- endif -%}
        {%- if block.settings.heading != blank -%}
          <h1 class="s24-hero__title">{{ block.settings.heading }}</h1>
        {%- endif -%}
        <div class="s24-hero__actions">
          {%- if block.settings.button_label != blank -%}
            <a class="s24-btn s24-btn--outline" href="{{ block.settings.button_link | default: routes.all_products_collection_url }}">
              {{ block.settings.button_label | escape }}
            </a>
          {%- endif -%}
          <a class="s24-hero__play" href="{{ block.settings.button_link | default: routes.all_products_collection_url }}" aria-label="Play">
            <span class="s24-hero__play-icon"></span>
          </a>
        </div>
      </div>
      <div class="s24-hero__media">
        {%- if block.settings.image != blank -%}
          {{
            block.settings.image
            | image_url: width: 1800
            | image_tag: loading: 'eager', widths: '600, 900, 1200, 1800', alt: block.settings.heading
          }}
        {%- else -%}
          {{ 'lifestyle-2' | placeholder_svg_tag: 'placeholder-svg' }}
        {%- endif -%}
        {%- if block.settings.overlay_word != blank -%}
          <span class="s24-hero__watermark">{{ block.settings.overlay_word | escape }}</span>
        {%- endif -%}
      </div>
    </article>
  {%- endfor -%}

  {%- if section.blocks.size > 1 -%}
    <div class="s24-hero__nav">
      <button type="button" class="s24-hero__arrow" data-s24-hero-prev aria-label="Previous">‹</button>
      <div class="s24-hero__dots">
        {%- for block in section.blocks -%}
          <button type="button" class="s24-hero__dot{% if forloop.first %} is-active{% endif %}" data-s24-hero-dot aria-label="Slide {{ forloop.index }}"></button>
        {%- endfor -%}
      </div>
      <button type="button" class="s24-hero__arrow" data-s24-hero-next aria-label="Next">›</button>
    </div>
  {%- endif -%}
</section>

{% schema %}
{
  "name": "S24 hero",
  "tag": "section",
  "class": "section",
  "max_blocks": 6,
  "disabled_on": { "groups": ["header", "footer"] },
  "settings": [],
  "blocks": [
    {
      "type": "slide",
      "name": "Slide",
      "settings": [
        { "type": "text", "id": "kicker", "label": "Small heading", "default": "New trending style" },
        { "type": "text", "id": "heading", "label": "Heading", "default": "African Luxury Elegance." },
        { "type": "text", "id": "button_label", "label": "Button", "default": "Shop Now" },
        { "type": "url", "id": "button_link", "label": "Link" },
        { "type": "image_picker", "id": "image", "label": "Image" },
        { "type": "text", "id": "overlay_word", "label": "Overlay word", "default": "Fashion" }
      ]
    }
  ],
  "presets": [
    {
      "name": "S24 hero",
      "blocks": [{ "type": "slide" }, { "type": "slide" }]
    }
  ]
}
{% endschema %}
