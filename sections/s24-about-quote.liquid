{% comment %}
  About quote band — plum full-bleed statement.
{% endcomment %}

{%- style -%}
  .s24-about-quote-{{ section.id }} {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round }}px;
    background: {{ section.settings.bg_color }};
    color: {{ section.settings.text_color }};
  }
  @media screen and (min-width: 750px) {
    .s24-about-quote-{{ section.id }} {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }
{%- endstyle -%}

<section class="s24-about-quote s24-about-quote-{{ section.id }}">
  <div class="page-width s24-about-quote__inner">
    {%- if section.settings.quote != blank -%}
      <blockquote class="s24-about-quote__text">
        <p>“{{ section.settings.quote | escape | newline_to_br }}”</p>
      </blockquote>
    {%- endif -%}
    {%- if section.settings.attribution != blank -%}
      <p class="s24-about-quote__attr">{{ section.settings.attribution | escape }}</p>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "S24 about quote",
  "tag": "section",
  "class": "section",
  "disabled_on": { "groups": ["header", "footer"] },
  "settings": [
    {
      "type": "textarea",
      "id": "quote",
      "label": "Quote",
      "default": "I didn't just move to Canada. I carried my dreams, my culture, and my passion with me. Every design I create is a reminder that elegance has no borders."
    },
    {
      "type": "text",
      "id": "attribution",
      "label": "Attribution",
      "default": "— Cecilia, Founder & Creative Director"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background",
      "default": "#a61669"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text",
      "default": "#ffffff"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Padding top",
      "default": 72
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Padding bottom",
      "default": 72
    }
  ],
  "presets": [{ "name": "S24 about quote" }]
}
{% endschema %}
