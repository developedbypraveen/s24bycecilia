{% comment %}
  Full-width marquee — alternating solid and outline text, scrolling loop.
{% endcomment %}

{%- assign marquee_text = section.settings.text | default: 'Heritage · Elegance · Made to fit' -%}

<section class="s24-marquee" aria-label="{{ marquee_text | escape }}">
  <div class="s24-marquee__track">
    {%- for copy in (1..2) -%}
      {%- for i in (1..6) -%}
        <span class="s24-marquee__item{% cycle ' is-solid', ' is-outline' %}">{{ marquee_text | escape }}</span>
      {%- endfor -%}
    {%- endfor -%}
  </div>
</section>

{% schema %}
{
  "name": "S24 marquee",
  "tag": "section",
  "class": "section",
  "disabled_on": { "groups": ["header", "footer"] },
  "settings": [
    {
      "type": "text",
      "id": "text",
      "label": "Scrolling text",
      "default": "Heritage · Elegance · Made to fit"
    }
  ],
  "presets": [{ "name": "S24 marquee" }]
}
{% endschema %}
