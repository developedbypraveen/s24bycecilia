{% comment %}
  Instagram — heading plus an Instagram / Reels app from the theme editor.
{% endcomment %}

{%- style -%}
  .s24-ig-{{ section.id }} {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round }}px;
  }
  @media screen and (min-width: 750px) {
    .s24-ig-{{ section.id }} {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }
{%- endstyle -%}

<section class="s24-ig s24-ig--app s24-ig-{{ section.id }}">
  {%- if section.settings.title != blank or section.settings.subtitle != blank -%}
    <div class="s24-ig__intro">
      {% render 's24-heading', title: section.settings.title, subtitle: section.settings.subtitle %}
    </div>
  {%- endif -%}

  <div class="s24-ig__app">
    {%- for block in section.blocks -%}
      {% render block %}
    {%- else -%}
      {%- if request.design_mode -%}
        <p class="s24-ig__hint">Add your Instagram app here: Theme editor → Instagram → Add block → Apps.</p>
      {%- endif -%}
    {%- endfor -%}
  </div>
</section>

{% schema %}
{
  "name": "Instagram",
  "tag": "section",
  "class": "section",
  "disabled_on": { "groups": ["header", "footer"] },
  "settings": [
    { "type": "text", "id": "title", "label": "Heading", "default": "On Instagram" },
    { "type": "textarea", "id": "subtitle", "label": "Subtitle", "default": "New looks, fabric moments, and styling notes — follow the feed for what’s next from S24." },
    { "type": "paragraph", "content": "Install an Instagram app, then add it as a block in this section." },
    { "type": "range", "id": "padding_top", "min": 0, "max": 100, "step": 4, "unit": "px", "label": "Padding top", "default": 48 },
    { "type": "range", "id": "padding_bottom", "min": 0, "max": 100, "step": 4, "unit": "px", "label": "Padding bottom", "default": 40 }
  ],
  "blocks": [
    {
      "type": "@app"
    }
  ],
  "presets": [
    {
      "name": "Instagram"
    }
  ]
}
{% endschema %}
