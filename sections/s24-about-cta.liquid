{% comment %}
  About CTA — shop + contact / appointment.
{% endcomment %}

{%- style -%}
  .s24-about-cta-{{ section.id }} {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round }}px;
  }
  @media screen and (min-width: 750px) {
    .s24-about-cta-{{ section.id }} {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }
{%- endstyle -%}

<section class="s24-about-cta s24-about-cta-{{ section.id }}">
  <div class="page-width s24-about-cta__inner">
    {%- if section.settings.heading != blank -%}
      <h2 class="s24-about-cta__heading">{{ section.settings.heading | escape }}</h2>
    {%- endif -%}
    {%- if section.settings.text != blank -%}
      <p class="s24-about-cta__text">{{ section.settings.text | escape }}</p>
    {%- endif -%}
    <div class="s24-about-cta__actions">
      {%- if section.settings.button_label_1 != blank -%}
        <a
          class="s24-btn"
          href="{{ section.settings.button_link_1 | default: routes.all_products_collection_url }}"
        >
          {{ section.settings.button_label_1 | escape }}
        </a>
      {%- endif -%}
      {%- if section.settings.button_label_2 != blank -%}
        <a
          class="s24-btn s24-btn--outline"
          href="{{ section.settings.button_link_2 | default: '/pages/contact' }}"
        >
          {{ section.settings.button_label_2 | escape }}
        </a>
      {%- endif -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "S24 about CTA",
  "tag": "section",
  "class": "section",
  "disabled_on": { "groups": ["header", "footer"] },
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Ready to find your next piece?"
    },
    {
      "type": "textarea",
      "id": "text",
      "label": "Text",
      "default": "Explore ready-to-wear, or book a conversation about a custom order made for you."
    },
    {
      "type": "text",
      "id": "button_label_1",
      "label": "Primary button",
      "default": "Shop now"
    },
    {
      "type": "url",
      "id": "button_link_1",
      "label": "Primary link"
    },
    {
      "type": "text",
      "id": "button_label_2",
      "label": "Secondary button",
      "default": "Book appointment"
    },
    {
      "type": "url",
      "id": "button_link_2",
      "label": "Secondary link"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Padding top",
      "default": 64
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Padding bottom",
      "default": 80
    }
  ],
  "presets": [{ "name": "S24 about CTA" }]
}
{% endschema %}
