{
  "name": "t:sections.header.name",
  "type": "header",
  "sections": {
    "announcement-bar": {
      "type": "announcement-bar",
      "blocks": {
        "announcement-bar-0": {
          "type": "announcement",
          "settings": {
            "text": "Welcome to S24 By Cecilia — learn more",
            "link": "shopify://pages/about"
          }
        },
        "announcement-bar-1": {
          "type": "announcement",
          "settings": {
            "text": "African luxury fashion — ready-to-wear and custom",
            "link": "shopify://collections/shop-all"
          }
        },
        "announcement-bar-2": {
          "type": "announcement",
          "settings": {
            "text": "Designed in Canada — book a custom appointment",
            "link": "shopify://collections/custom-orders"
          }
        }
      },
      "block_order": ["announcement-bar-0", "announcement-bar-1", "announcement-bar-2"],
      "settings": {
        "auto_rotate": true,
        "change_slides_speed": 5,
        "color_scheme": "scheme-4",
        "show_line_separator": false,
        "show_social": true,
        "enable_country_selector": true,
        "enable_language_selector": true
      }
    },
    "header": {
      "type": "header",
      "settings": {
        "logo_position": "middle-left",
        "mobile_logo_position": "center",
        "menu": "main-menu",
        "menu_type_desktop": "dropdown",
        "sticky_header_type": "always",
        "show_line_separator": true,
        "color_scheme": "scheme-1",
        "menu_color_scheme": "scheme-1",
        "enable_country_selector": false,
        "enable_language_selector": false,
        "show_search": false,
        "enable_customer_avatar": true,
        "margin_bottom": 0,
        "padding_top": 12,
        "padding_bottom": 12
      }
    }
  },
  "order": ["announcement-bar", "header"]
}
