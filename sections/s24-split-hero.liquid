{% comment %}
  S24 two-column hero slider.
  Each slide: left content (50%) + right image (50%).
{% endcomment %}

<section
  class="s24-hero s24-hero--slider color-{{ section.settings.color_scheme }}"
  data-s24-hero
  data-interval="{{ section.settings.autoplay_speed | times: 1000 }}"
>
  {%- for block in section.blocks -%}
    <article
      class="s24-hero__slide{% if forloop.first %} is-active{% endif %}"
      data-s24-hero-slide
      {{ block.shopify_attributes }}
    >
      <div class="s24-hero__copy">
        {%- if block.settings.kicker != blank -%}
          <p class="s24-hero__kicker">{{ block.settings.kicker | escape }}</p>
        {%- endif -%}
        {%- if block.settings.heading != blank -%}
          <h1 class="s24-hero__title">{{ block.settings.heading }}</h1>
        {%- endif -%}
        {%- if block.settings.text != blank -%}
          <p class="s24-hero__text">{{ block.settings.text | escape }}</p>
        {%- endif -%}
        <div class="s24-hero__actions">
          {%- if block.settings.button_label != blank -%}
            <a class="s24-btn s24-btn--outline" href="{{ block.settings.button_link | default: routes.all_products_collection_url }}">
              {{ block.settings.button_label | escape }}
            </a>
          {%- endif -%}
          <a
            class="s24-hero__play"
            href="{{ block.settings.video_url | default: routes.all_products_collection_url }}"
            aria-label="Play"
          >
            <span class="s24-hero__play-icon"></span>
          </a>
        </div>
      </div>
      <div class="s24-hero__media">
        {%- liquid
          if forloop.first
            assign hero_loading = 'eager'
          else
            assign hero_loading = 'lazy'
          endif
        -%}
        {%- if block.settings.image != blank -%}
          {{
            block.settings.image
            | image_url: width: 1800
            | image_tag:
              loading: hero_loading,
              widths: '600, 900, 1200, 1600, 1800',
              alt: block.settings.heading
          }}
        {%- elsif block.settings.fallback_image != blank -%}
          <img
            src="{{ block.settings.fallback_image }}"
            alt="{{ block.settings.heading | escape }}"
            loading="{{ hero_loading }}"
            width="1800"
            height="1800"
          >
        {%- else -%}
          {{ 'lifestyle-2' | placeholder_svg_tag: 'placeholder-svg' }}
        {%- endif -%}
        {%- if block.settings.overlay_word != blank -%}
          <span class="s24-hero__watermark">{{ block.settings.overlay_word | escape }}</span>
        {%- endif -%}
      </div>
    </article>
  {%- endfor -%}

  {%- if section.blocks.size > 1 -%}
    <div class="s24-hero__nav">
      <button type="button" class="s24-hero__arrow" data-s24-hero-prev aria-label="Previous">‹</button>
      <div class="s24-hero__dots">
        {%- for block in section.blocks -%}
          <button
            type="button"
            class="s24-hero__dot{% if forloop.first %} is-active{% endif %}"
            data-s24-hero-dot
            aria-label="Slide {{ forloop.index }}"
          ></button>
        {%- endfor -%}
      </div>
      <button type="button" class="s24-hero__arrow" data-s24-hero-next aria-label="Next">›</button>
    </div>
  {%- endif -%}
</section>

{% schema %}
{
  "name": "S24 split hero",
  "tag": "section",
  "class": "s24-hero-section",
  "disabled_on": { "groups": ["header", "footer"] },
  "settings": [
    {
      "type": "range",
      "id": "autoplay_speed",
      "min": 3,
      "max": 10,
      "step": 1,
      "unit": "s",
      "label": "Autoplay speed",
      "default": 6
    },
    { "type": "color_scheme", "id": "color_scheme", "label": "Color scheme", "default": "scheme-1" }
  ],
  "blocks": [
    {
      "type": "slide",
      "name": "Slide",
      "settings": [
        { "type": "text", "id": "kicker", "label": "Small heading", "default": "New trending style" },
        { "type": "inline_richtext", "id": "heading", "label": "Heading", "default": "African Luxury<br>Elegance." },
        { "type": "textarea", "id": "text", "label": "Text", "default": "Heritage print. Modern cut. Designed in Canada." },
        { "type": "text", "id": "button_label", "label": "Button", "default": "Shop Now" },
        { "type": "url", "id": "button_link", "label": "Button link" },
        { "type": "url", "id": "video_url", "label": "Play button link" },
        { "type": "image_picker", "id": "image", "label": "Image" },
        { "type": "text", "id": "fallback_image", "label": "Fallback image URL" },
        { "type": "text", "id": "overlay_word", "label": "Image overlay word", "default": "Fashion" }
      ]
    }
  ],
  "presets": [
    {
      "name": "S24 split hero",
      "blocks": [{ "type": "slide" }, { "type": "slide" }]
    }
  ]
}
{% endschema %}
