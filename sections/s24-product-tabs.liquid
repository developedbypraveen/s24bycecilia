{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }
{%- endstyle -%}

{{ 'component-accordion.css' | asset_url | stylesheet_tag }}

{%- capture accordion_content -%}
  {%- render 's24-product-accordion',
    product: product,
    section: section,
    heading: section.settings.heading,
    heading_size: section.settings.heading_size,
    care_label: section.settings.care_label,
    style_label: section.settings.style_label,
    fabric_label: section.settings.fabric_label,
    open_first: section.settings.open_first
  -%}
{%- endcapture -%}

{%- unless accordion_content == blank -%}
  <div class="color-{{ section.settings.color_scheme }} gradient">
    <div class="page-width section-{{ section.id }}-padding">
      {{ accordion_content }}
    </div>
  </div>
{%- endunless -%}

{% schema %}
{
  "name": "S24 Product accordion",
  "enabled_on": {
    "templates": ["product"]
  },
  "settings": [
    {
      "type": "paragraph",
      "content": "Shows one accordion row per product metafield. Preferred: custom.product_accordions (list of metaobjects with Title + Content). Fallback: custom.care_info, custom.how_to_style, custom.fabric_info."
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Product details"
    },
    {
      "type": "select",
      "id": "heading_size",
      "options": [
        { "value": "h2", "label": "Small" },
        { "value": "h1", "label": "Medium" },
        { "value": "h0", "label": "Large" }
      ],
      "default": "h2",
      "label": "Heading size"
    },
    {
      "type": "text",
      "id": "care_label",
      "label": "Care title (fallback metafield)",
      "default": "Care"
    },
    {
      "type": "text",
      "id": "style_label",
      "label": "Style title (fallback metafield)",
      "default": "How to Style"
    },
    {
      "type": "text",
      "id": "fabric_label",
      "label": "Fabric title (fallback metafield)",
      "default": "Fabric"
    },
    {
      "type": "checkbox",
      "id": "open_first",
      "label": "Open first accordion by default",
      "default": true
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Top padding",
      "default": 24
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Bottom padding",
      "default": 36
    }
  ],
  "presets": [
    {
      "name": "S24 Product accordion"
    }
  ]
}
{% endschema %}
