{% comment %}
  S24 By Cecilia — Homepage “Why choose” pillars
  Three short brand reasons under the founder story.
  Colors inherit from the selected color scheme.
{% endcomment %}

{{ 's24-brand.css' | asset_url | stylesheet_tag }}

{%- style -%}
  .s24-pillars-{{ section.id }} {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round }}px;
  }

  @media screen and (min-width: 750px) {
    .s24-pillars-{{ section.id }} {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }
{%- endstyle -%}

<div class="s24-pillars color-{{ section.settings.color_scheme }} gradient s24-pillars-{{ section.id }}">
  <div class="page-width">
    <div class="s24-pillars__intro">
      {%- if section.settings.kicker != blank -%}
        <p class="s24-pillars__kicker">{{ section.settings.kicker | escape }}</p>
      {%- endif -%}
      {%- if section.settings.heading != blank -%}
        <h2 class="s24-pillars__heading">{{ section.settings.heading | escape }}</h2>
      {%- endif -%}
    </div>

    <div class="s24-pillars__grid">
      {%- for block in section.blocks -%}
        <article class="s24-pillars__item" {{ block.shopify_attributes }}>
          <span class="s24-pillars__index" aria-hidden="true">{{ forloop.index | prepend: '0' }}</span>
          <h3 class="s24-pillars__title">{{ block.settings.heading | escape }}</h3>
          <p class="s24-pillars__text">{{ block.settings.text | escape }}</p>
        </article>
      {%- endfor -%}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "S24 pillars",
  "tag": "section",
  "class": "section",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "text",
      "id": "kicker",
      "label": "Small heading",
      "default": "Why S24 By Cecilia"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Clothing that feels as unique as you"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Padding top",
      "default": 72
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Padding bottom",
      "default": 72
    }
  ],
  "blocks": [
    {
      "type": "pillar",
      "name": "Pillar",
      "settings": [
        {
          "type": "text",
          "id": "heading",
          "label": "Heading",
          "default": "Heritage, made modern"
        },
        {
          "type": "textarea",
          "id": "text",
          "label": "Text",
          "default": "African print and craftsmanship cut for the way you live now."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "S24 pillars",
      "blocks": [
        { "type": "pillar" },
        { "type": "pillar" },
        { "type": "pillar" }
      ]
    }
  ]
}
{% endschema %}
