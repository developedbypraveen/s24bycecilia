{% comment %}
  Four service icons in a row — Fast delivery / Secure payment / Support / Returns.
{% endcomment %}

{%- style -%}
  .s24-services-{{ section.id }} {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round }}px;
  }
  @media screen and (min-width: 750px) {
    .s24-services-{{ section.id }} {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }
{%- endstyle -%}

<section class="s24-services s24-services-{{ section.id }}">
  <div class="page-width">
    <div class="s24-services__grid">
      {%- for block in section.blocks -%}
        <article class="s24-service" {{ block.shopify_attributes }}>
          <span class="s24-service__icon" aria-hidden="true">{{ block.settings.icon | default: '✦' }}</span>
          <h3>{{ block.settings.heading | escape }}</h3>
          <p>{{ block.settings.text | escape }}</p>
        </article>
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "S24 services",
  "tag": "section",
  "class": "section",
  "max_blocks": 4,
  "disabled_on": { "groups": ["header", "footer"] },
  "settings": [
    { "type": "range", "id": "padding_top", "min": 0, "max": 100, "step": 4, "unit": "px", "label": "Padding top", "default": 28 },
    { "type": "range", "id": "padding_bottom", "min": 0, "max": 100, "step": 4, "unit": "px", "label": "Padding bottom", "default": 28 }
  ],
  "blocks": [
    {
      "type": "service",
      "name": "Service",
      "settings": [
        { "type": "text", "id": "icon", "label": "Icon (emoji or symbol)", "default": "✦" },
        { "type": "text", "id": "heading", "label": "Heading", "default": "Fast delivery" },
        { "type": "textarea", "id": "text", "label": "Text", "default": "Careful shipping on every ready-to-wear order." }
      ]
    }
  ],
  "presets": [
    {
      "name": "S24 services",
      "blocks": [
        { "type": "service" },
        { "type": "service" },
        { "type": "service" },
        { "type": "service" }
      ]
    }
  ]
}
{% endschema %}
