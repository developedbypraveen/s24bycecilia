{% comment %}
  Four service blocks — circular outline icon + title/subtitle, divided columns.
{% endcomment %}

{%- style -%}
  .s24-services-{{ section.id }} {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round }}px;
  }
  @media screen and (min-width: 750px) {
    .s24-services-{{ section.id }} {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }
{%- endstyle -%}

<section class="s24-services s24-services-{{ section.id }}">
  <div class="page-width">
    <div class="s24-services__grid">
      {%- for block in section.blocks -%}
        <article class="s24-service" {{ block.shopify_attributes }}>
          <span class="s24-service__icon" aria-hidden="true">
            {%- case block.settings.icon -%}
              {%- when 'shipping' -%}
                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M3 7h11v10H3z"/><path d="M14 10h4l3 3v4h-7"/><circle cx="7" cy="17" r="2"/><circle cx="18" cy="17" r="2"/></svg>
              {%- when 'payment' -%}
                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><rect x="3" y="6" width="18" height="12" rx="2"/><path d="M3 10h18"/><path d="M7 15h4"/></svg>
              {%- when 'returns' -%}
                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M4 8h11a4 4 0 0 1 0 8H8"/><path d="M8 4 4 8l4 4"/></svg>
              {%- when 'gift' -%}
                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><rect x="4" y="11" width="16" height="9" rx="1"/><path d="M4 11V8h16v3"/><path d="M12 8v12"/><path d="M12 8c0-2-1.5-3.5-3.5-3.5S5 6 5 8h7"/><path d="M12 8c0-2 1.5-3.5 3.5-3.5S19 6 19 8h-7"/></svg>
              {%- else -%}
                {{ block.settings.icon }}
            {%- endcase -%}
          </span>
          <div class="s24-service__copy">
            <h3>{{ block.settings.heading | escape }}</h3>
            <p>{{ block.settings.text | escape }}</p>
          </div>
        </article>
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "S24 services",
  "tag": "section",
  "class": "section",
  "max_blocks": 4,
  "disabled_on": { "groups": ["header", "footer"] },
  "settings": [
    { "type": "range", "id": "padding_top", "min": 0, "max": 100, "step": 4, "unit": "px", "label": "Padding top", "default": 40 },
    { "type": "range", "id": "padding_bottom", "min": 0, "max": 100, "step": 4, "unit": "px", "label": "Padding bottom", "default": 40 }
  ],
  "blocks": [
    {
      "type": "service",
      "name": "Service",
      "settings": [
        {
          "type": "select",
          "id": "icon",
          "label": "Icon",
          "options": [
            { "value": "shipping", "label": "Shipping" },
            { "value": "payment", "label": "Payment" },
            { "value": "returns", "label": "Returns" },
            { "value": "gift", "label": "Gift" }
          ],
          "default": "shipping"
        },
        { "type": "text", "id": "heading", "label": "Heading", "default": "Worldwide Shipping" },
        { "type": "textarea", "id": "text", "label": "Text", "default": "Packed with care from the Canada studio." }
      ]
    }
  ],
  "presets": [
    {
      "name": "S24 services",
      "blocks": [
        { "type": "service" },
        { "type": "service" },
        { "type": "service" },
        { "type": "service" }
      ]
    }
  ]
}
{% endschema %}
