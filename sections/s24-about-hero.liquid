{% comment %}
  About page hero — brand title + short intro.
{% endcomment %}

{%- style -%}
  .s24-about-hero-{{ section.id }} {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round }}px;
  }
  @media screen and (min-width: 750px) {
    .s24-about-hero-{{ section.id }} {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }
{%- endstyle -%}

<section class="s24-about-hero s24-about-hero-{{ section.id }}">
  <div class="page-width s24-about-hero__inner">
    {%- if section.settings.kicker != blank -%}
      <p class="s24-about-hero__kicker">{{ section.settings.kicker | escape }}</p>
    {%- endif -%}
    {%- if section.settings.heading != blank -%}
      <h1 class="s24-about-hero__title">{{ section.settings.heading | escape }}</h1>
    {%- endif -%}
    {%- if section.settings.text != blank -%}
      <p class="s24-about-hero__text">{{ section.settings.text | escape }}</p>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "S24 about hero",
  "tag": "section",
  "class": "section",
  "disabled_on": { "groups": ["header", "footer"] },
  "settings": [
    {
      "type": "text",
      "id": "kicker",
      "label": "Kicker",
      "default": "S24 By Cecilia"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "African Luxury Fashion for Women Who Love Elegance"
    },
    {
      "type": "textarea",
      "id": "text",
      "label": "Intro",
      "default": "Meet Cecilia — founder and creative director. A story of courage, culture, and clothing that makes every woman feel unforgettable."
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Padding top",
      "default": 72
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Padding bottom",
      "default": 40
    }
  ],
  "presets": [{ "name": "S24 about hero" }]
}
{% endschema %}
