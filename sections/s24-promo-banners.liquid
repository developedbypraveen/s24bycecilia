{% comment %}
  Three rounded promo banners in a row — Spring / Sale / New Arrivals style.
{% endcomment %}

{%- style -%}
  .s24-promos-{{ section.id }} {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round }}px;
  }
  @media screen and (min-width: 750px) {
    .s24-promos-{{ section.id }} {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }
{%- endstyle -%}

<section class="s24-promos s24-promos-{{ section.id }}">
  <div class="page-width">
    <div class="s24-promos__grid">
      {%- for block in section.blocks -%}
        <article class="s24-promo-card" {{ block.shopify_attributes }}>
          {%- if block.settings.image != blank -%}
            {{
              block.settings.image
              | image_url: width: 900
              | image_tag: loading: 'lazy', widths: '400, 600, 900', alt: block.settings.heading
            }}
          {%- else -%}
            {{ 'collection-apparel-1' | placeholder_svg_tag: 'placeholder-svg' }}
          {%- endif -%}
          <div class="s24-promo-card__overlay">
            {%- if block.settings.kicker != blank -%}
              <p>{{ block.settings.kicker | escape }}</p>
            {%- endif -%}
            {%- if block.settings.heading != blank -%}
              <h3>{{ block.settings.heading | escape }}</h3>
            {%- endif -%}
            {%- if block.settings.button_label != blank -%}
              <a class="s24-btn s24-btn--light" href="{{ block.settings.button_link | default: routes.all_products_collection_url }}">
                {{ block.settings.button_label | escape }}
              </a>
            {%- endif -%}
          </div>
        </article>
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "S24 promo banners",
  "tag": "section",
  "class": "section",
  "max_blocks": 3,
  "disabled_on": { "groups": ["header", "footer"] },
  "settings": [
    { "type": "range", "id": "padding_top", "min": 0, "max": 100, "step": 4, "unit": "px", "label": "Padding top", "default": 20 },
    { "type": "range", "id": "padding_bottom", "min": 0, "max": 100, "step": 4, "unit": "px", "label": "Padding bottom", "default": 20 }
  ],
  "blocks": [
    {
      "type": "banner",
      "name": "Banner",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Image" },
        { "type": "text", "id": "kicker", "label": "Small text", "default": "Just for you" },
        { "type": "text", "id": "heading", "label": "Heading", "default": "Spring style" },
        { "type": "text", "id": "button_label", "label": "Button", "default": "Shop now" },
        { "type": "url", "id": "button_link", "label": "Link" }
      ]
    }
  ],
  "presets": [
    {
      "name": "S24 promo banners",
      "blocks": [{ "type": "banner" }, { "type": "banner" }, { "type": "banner" }]
    }
  ]
}
{% endschema %}
