{% comment %}
  Sale banner — plum offer left, 4 products on blush right.
{% endcomment %}

{{ 'component-card.css' | asset_url | stylesheet_tag }}
{{ 'component-price.css' | asset_url | stylesheet_tag }}

{%- style -%}
  .s24-sale-{{ section.id }} {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round }}px;
  }
  @media screen and (min-width: 750px) {
    .s24-sale-{{ section.id }} {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }
  .s24-sale-{{ section.id }} .s24-sale__offer {
    background: {{ section.settings.offer_bg }};
    color: {{ section.settings.offer_text }};
  }
  .s24-sale-{{ section.id }} .s24-sale__products {
    background: {{ section.settings.products_bg }};
  }
{%- endstyle -%}

{%- liquid
  assign collection = section.settings.collection
  assign picked = section.settings.product_list
  assign limit = 4
  assign btn_url = section.settings.button_link
  if btn_url == blank and collection != blank
    assign btn_url = collection.url
  endif
  if btn_url == blank
    assign btn_url = routes.all_products_collection_url
  endif
-%}

<section class="s24-sale s24-sale-{{ section.id }}">
  <div class="page-width">
    <div class="s24-sale__panel">
      <div class="s24-sale__offer">
        {%- if section.settings.eyebrow != blank -%}
          <p class="s24-sale__eyebrow">{{ section.settings.eyebrow | escape }}</p>
        {%- endif -%}
        {%- if section.settings.heading != blank -%}
          <h2 class="s24-sale__heading">{{ section.settings.heading | escape }}</h2>
        {%- endif -%}
        {%- if section.settings.text != blank -%}
          <p class="s24-sale__text">{{ section.settings.text | escape }}</p>
        {%- endif -%}
        {%- if section.settings.button_label != blank -%}
          <a class="s24-sale__btn" href="{{ btn_url }}">
            {{ section.settings.button_label | escape }}
          </a>
        {%- endif -%}
      </div>

      <div class="s24-sale__products">
        <ul class="s24-sale__grid" role="list">
          {%- if picked != blank and picked.size > 0 -%}
            {%- for product in picked limit: limit -%}
              <li class="s24-sale__item">
                {% render 'card-product',
                  card_product: product,
                  media_aspect_ratio: 'portrait',
                  show_secondary_image: true,
                  show_vendor: false,
                  show_rating: false,
                  section_id: section.id,
                  product_view_context: 'collection'
                %}
              </li>
            {%- endfor -%}
          {%- elsif collection != blank -%}
            {%- for product in collection.products limit: limit -%}
              <li class="s24-sale__item">
                {% render 'card-product',
                  card_product: product,
                  media_aspect_ratio: 'portrait',
                  show_secondary_image: true,
                  show_vendor: false,
                  show_rating: false,
                  section_id: section.id,
                  product_view_context: 'collection'
                %}
              </li>
            {%- endfor -%}
          {%- else -%}
            {%- for i in (1..4) -%}
              <li class="s24-sale__item">
                {% render 'card-product', media_aspect_ratio: 'portrait', section_id: section.id, show_secondary_image: true %}
              </li>
            {%- endfor -%}
          {%- endif -%}
        </ul>
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "S24 sale banner",
  "tag": "section",
  "class": "section",
  "disabled_on": { "groups": ["header", "footer"] },
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Limited time"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "50% OFF"
    },
    {
      "type": "textarea",
      "id": "text",
      "label": "Supporting text",
      "default": "Selected ready-to-wear styles — while they last."
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label",
      "default": "Shop Now"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button link"
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Product collection"
    },
    {
      "type": "product_list",
      "id": "product_list",
      "label": "Or choose 4 products",
      "limit": 4
    },
    {
      "type": "color",
      "id": "offer_bg",
      "label": "Offer background",
      "default": "#a61669"
    },
    {
      "type": "color",
      "id": "offer_text",
      "label": "Offer text",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "products_bg",
      "label": "Products background",
      "default": "#f7e9ef"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Padding top",
      "default": 40
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Padding bottom",
      "default": 40
    }
  ],
  "presets": [
    {
      "name": "S24 sale banner"
    }
  ]
}
{% endschema %}
