{% comment %}
  Sale banner — plum offer left, on-sale products slider on blush right.
{% endcomment %}

{{ 'component-card.css' | asset_url | stylesheet_tag }}
{{ 'component-price.css' | asset_url | stylesheet_tag }}

{%- style -%}
  .s24-sale-{{ section.id }} {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round }}px;
  }
  @media screen and (min-width: 750px) {
    .s24-sale-{{ section.id }} {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }
  .s24-sale-{{ section.id }} .s24-sale__offer {
    background: {{ section.settings.offer_bg }};
    color: {{ section.settings.offer_text }};
  }
  .s24-sale-{{ section.id }} .s24-sale__products {
    background: {{ section.settings.products_bg }};
    --s24-sale-visible: {{ section.settings.products_visible | default: 4 }};
  }
{%- endstyle -%}

{%- liquid
  assign source = section.settings.collection
  if source == blank
    assign source = collections.all
  endif
  assign btn_url = section.settings.button_link
  if btn_url == blank and section.settings.collection != blank
    assign btn_url = section.settings.collection.url
  endif
  if btn_url == blank
    assign btn_url = routes.all_products_collection_url
  endif
  assign sale_count = 0
  assign max_sale = section.settings.max_products | default: 24
-%}

<section class="s24-sale s24-sale-{{ section.id }}" id="sale-banner">
  <div class="s24-sale__panel">
      <div class="s24-sale__offer">
        {%- if section.settings.eyebrow != blank -%}
          <p class="s24-sale__eyebrow">{{ section.settings.eyebrow | escape }}</p>
        {%- endif -%}
        {%- if section.settings.heading != blank -%}
          <h2 class="s24-sale__heading">{{ section.settings.heading | escape }}</h2>
        {%- endif -%}
        {%- if section.settings.text != blank -%}
          <p class="s24-sale__text">{{ section.settings.text | escape }}</p>
        {%- endif -%}
        {%- if section.settings.button_label != blank -%}
          <a class="s24-sale__btn" href="{{ btn_url }}">
            {{ section.settings.button_label | escape }}
          </a>
        {%- endif -%}
      </div>

      <div
        class="s24-sale__products"
        data-s24-sale-slider
        data-visible="{{ section.settings.products_visible | default: 4 }}"
      >
        <div class="s24-sale__slider-head">
          <p class="s24-sale__slider-label">On sale</p>
          <div class="s24-sale__nav">
            <button type="button" class="s24-sale__arrow" data-s24-sale-prev aria-label="Previous">‹</button>
            <button type="button" class="s24-sale__arrow" data-s24-sale-next aria-label="Next">›</button>
          </div>
        </div>

        <div class="s24-sale__viewport">
          <ul class="s24-sale__track" role="list" data-s24-sale-track>
            {%- paginate source.products by 100 -%}
              {%- for product in source.products -%}
                {%- if product.compare_at_price > product.price and sale_count < max_sale -%}
                  {%- assign sale_count = sale_count | plus: 1 -%}
                  <li class="s24-sale__item" data-s24-sale-item>
                    {% render 'card-product',
                      card_product: product,
                      media_aspect_ratio: 'portrait',
                      show_secondary_image: true,
                      show_vendor: false,
                      show_rating: false,
                      section_id: section.id,
                      product_view_context: 'collection'
                    %}
                  </li>
                {%- endif -%}
              {%- endfor -%}
            {%- endpaginate -%}

            {%- if sale_count == 0 -%}
              {%- for product in source.products limit: 8 -%}
                <li class="s24-sale__item" data-s24-sale-item>
                  {% render 'card-product',
                    card_product: product,
                    media_aspect_ratio: 'portrait',
                    show_secondary_image: true,
                    show_vendor: false,
                    show_rating: false,
                    section_id: section.id,
                    product_view_context: 'collection'
                  %}
                </li>
              {%- endfor -%}
            {%- endif -%}
          </ul>
        </div>
      </div>
  </div>
</section>

{% schema %}
{
  "name": "S24 sale banner",
  "tag": "section",
  "class": "section",
  "disabled_on": { "groups": ["header", "footer"] },
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Limited time"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "UPTO 50% OFF"
    },
    {
      "type": "textarea",
      "id": "text",
      "label": "Supporting text",
      "default": "Selected ready-to-wear styles — while they last."
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label",
      "default": "Shop Now"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button link"
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Scan collection for sale items",
      "info": "Leave blank to scan all products. Only products with compare-at price higher than price are shown."
    },
    {
      "type": "range",
      "id": "products_visible",
      "min": 2,
      "max": 6,
      "step": 1,
      "label": "Products visible",
      "info": "How many products show at once on desktop. Mobile shows up to 2.",
      "default": 4
    },
    {
      "type": "range",
      "id": "max_products",
      "min": 2,
      "max": 40,
      "step": 1,
      "label": "Max sale products in slider",
      "default": 24
    },
    {
      "type": "color",
      "id": "offer_bg",
      "label": "Offer background",
      "default": "#a61669"
    },
    {
      "type": "color",
      "id": "offer_text",
      "label": "Offer text",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "products_bg",
      "label": "Products background",
      "default": "#f7e9ef"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Padding top",
      "default": 40
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Padding bottom",
      "default": 40
    }
  ],
  "presets": [
    {
      "name": "S24 sale banner"
    }
  ]
}
{% endschema %}
