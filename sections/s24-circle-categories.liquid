{% comment %}
  Homepage category circles — image above, label below.
{% endcomment %}

{%- style -%}
  .s24-circles-{{ section.id }} {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round }}px;
  }
  @media screen and (min-width: 750px) {
    .s24-circles-{{ section.id }} {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }
{%- endstyle -%}

<section class="s24-circles s24-circles-{{ section.id }}">
  {%- if section.settings.title != blank or section.settings.subtitle != blank -%}
    <div class="page-width s24-circles__intro">
      {% render 's24-heading', title: section.settings.title, subtitle: section.settings.subtitle %}
    </div>
  {%- endif -%}

  <div class="page-width s24-circles__wrap">
    <ul class="s24-circles__row" role="list">
      {%- for block in section.blocks -%}
        {%- liquid
          assign cat_label = block.settings.label
          assign cat_link = block.settings.link
          if block.settings.collection != blank
            if cat_link == blank
              assign cat_link = block.settings.collection.url
            endif
            if cat_label == blank
              assign cat_label = block.settings.collection.title
            endif
          endif
        -%}
        <li class="s24-circles__item" {{ block.shopify_attributes }}>
          <a class="s24-circle" href="{{ cat_link | default: routes.all_products_collection_url }}">
            <span class="s24-circle__media">
              {%- if block.settings.image != blank -%}
                {{
                  block.settings.image
                  | image_url: width: 600
                  | image_tag: loading: 'lazy', widths: '240, 360, 480, 600', sizes: '(min-width: 990px) 160px, 28vw', alt: cat_label
                }}
              {%- elsif block.settings.collection.featured_image != blank -%}
                {{
                  block.settings.collection.featured_image
                  | image_url: width: 600
                  | image_tag: loading: 'lazy', widths: '240, 360, 480, 600', sizes: '(min-width: 990px) 160px, 28vw', alt: cat_label
                }}
              {%- else -%}
                {{ 'collection-apparel-2' | placeholder_svg_tag: 'placeholder-svg' }}
              {%- endif -%}
            </span>
            {%- if cat_label != blank -%}
              <span class="s24-circle__label">{{ cat_label | escape }}</span>
            {%- endif -%}
          </a>
        </li>
      {%- endfor -%}
    </ul>
  </div>
</section>

{% schema %}
{
  "name": "S24 circle categories",
  "tag": "section",
  "class": "section",
  "max_blocks": 8,
  "disabled_on": { "groups": ["header", "footer"] },
  "settings": [
    { "type": "text", "id": "title", "label": "Heading" },
    { "type": "textarea", "id": "subtitle", "label": "Subtitle" },
    { "type": "range", "id": "padding_top", "min": 0, "max": 100, "step": 4, "unit": "px", "label": "Padding top", "default": 40 },
    { "type": "range", "id": "padding_bottom", "min": 0, "max": 100, "step": 4, "unit": "px", "label": "Padding bottom", "default": 40 }
  ],
  "blocks": [
    {
      "type": "category",
      "name": "Category",
      "settings": [
        { "type": "collection", "id": "collection", "label": "Collection" },
        { "type": "image_picker", "id": "image", "label": "Circle image" },
        { "type": "text", "id": "label", "label": "Label", "default": "Tops" },
        { "type": "url", "id": "link", "label": "Link" }
      ]
    }
  ],
  "presets": [
    {
      "name": "S24 circle categories",
      "blocks": [
        { "type": "category", "settings": { "label": "Fabric" } },
        { "type": "category", "settings": { "label": "Ready-to-Wear" } },
        { "type": "category", "settings": { "label": "Pants" } },
        { "type": "category", "settings": { "label": "Tops" } },
        { "type": "category", "settings": { "label": "Two-Piece Sets" } }
      ]
    }
  ]
}
{% endschema %}
