{% comment %}
  Top category — circular image slider with overlay labels and side arrows.
{% endcomment %}

{{ 'component-slider.css' | asset_url | stylesheet_tag }}

{%- style -%}
  .s24-circles-{{ section.id }} {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round }}px;
  }
  @media screen and (min-width: 750px) {
    .s24-circles-{{ section.id }} {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }
{%- endstyle -%}

<section class="s24-circles s24-circles-{{ section.id }}">
  <div class="page-width">
    {% render 's24-heading', title: section.settings.title, subtitle: section.settings.subtitle %}
  </div>

  <slider-component class="s24-circles-slider page-width">
    {%- if section.blocks.size > 1 -%}
      <button
        type="button"
        class="s24-circles__arrow s24-circles__arrow--prev"
        name="previous"
        aria-label="Previous"
      >
        ‹
      </button>
    {%- endif -%}

    <ul id="Slider-{{ section.id }}" class="s24-circles__row slider slider--desktop slider--tablet" role="list">
      {%- for block in section.blocks -%}
        {%- liquid
          assign cat_label = block.settings.label
          assign cat_link = block.settings.link
          assign cat_count = blank
          if block.settings.collection != blank
            assign cat_count = block.settings.collection.all_products_count
            if cat_link == blank
              assign cat_link = block.settings.collection.url
            endif
            if cat_label == blank
              assign cat_label = block.settings.collection.title
            endif
          endif
        -%}
        <li id="Slide-{{ section.id }}-{{ forloop.index }}" class="s24-circles__item slider__slide" {{ block.shopify_attributes }}>
          <a class="s24-circle" href="{{ cat_link | default: routes.all_products_collection_url }}">
            <span class="s24-circle__media">
              {%- if block.settings.image != blank -%}
                {{
                  block.settings.image
                  | image_url: width: 600
                  | image_tag: loading: 'lazy', widths: '240, 360, 480, 600', alt: cat_label
                }}
              {%- elsif block.settings.collection.featured_image != blank -%}
                {{
                  block.settings.collection.featured_image
                  | image_url: width: 600
                  | image_tag: loading: 'lazy', widths: '240, 360, 480, 600', alt: cat_label
                }}
              {%- else -%}
                {{ 'collection-apparel-2' | placeholder_svg_tag: 'placeholder-svg' }}
              {%- endif -%}
            </span>
            <span class="s24-circle__overlay">
              {%- if cat_label != blank -%}
                <span class="s24-circle__label">{{ cat_label | escape }}</span>
              {%- endif -%}
              {%- if cat_count != blank -%}
                <span class="s24-circle__count">({{ cat_count }} {% if cat_count == 1 %}Item{% else %}Items{% endif %})</span>
              {%- endif -%}
            </span>
          </a>
        </li>
      {%- endfor -%}
    </ul>

    {%- if section.blocks.size > 1 -%}
      <button
        type="button"
        class="s24-circles__arrow s24-circles__arrow--next"
        name="next"
        aria-label="Next"
      >
        ›
      </button>
    {%- endif -%}
  </slider-component>
</section>

{% schema %}
{
  "name": "S24 circle categories",
  "tag": "section",
  "class": "section",
  "max_blocks": 8,
  "disabled_on": { "groups": ["header", "footer"] },
  "settings": [
    { "type": "text", "id": "title", "label": "Heading", "default": "Top category" },
    { "type": "textarea", "id": "subtitle", "label": "Subtitle", "default": "Follow the most popular trends and get exclusive pieces from the S24 studio." },
    { "type": "range", "id": "padding_top", "min": 0, "max": 100, "step": 4, "unit": "px", "label": "Padding top", "default": 72 },
    { "type": "range", "id": "padding_bottom", "min": 0, "max": 100, "step": 4, "unit": "px", "label": "Padding bottom", "default": 48 }
  ],
  "blocks": [
    {
      "type": "category",
      "name": "Category",
      "settings": [
        { "type": "collection", "id": "collection", "label": "Collection" },
        { "type": "image_picker", "id": "image", "label": "Image" },
        { "type": "text", "id": "label", "label": "Label", "default": "Tops" },
        { "type": "url", "id": "link", "label": "Link" }
      ]
    }
  ],
  "presets": [
    {
      "name": "S24 circle categories",
      "blocks": [
        { "type": "category" },
        { "type": "category" },
        { "type": "category" },
        { "type": "category" },
        { "type": "category" }
      ]
    }
  ]
}
{% endschema %}
