{% comment %}
  Sub-collections under a parent collection page.

  Setup (pick one):
  1. Metafield (best): Settings → Custom data → Collections → add
     Namespace/key: custom.sub_collections
     Type: List of collections
     Then edit each parent collection and select its sub-collections.

  2. Menu fallback: Online Store → Navigation → create a menu whose handle is
     sub-{collection-handle}  e.g. sub-ready-to-wear
     Add menu links to the child collections.
{% endcomment %}

{%- liquid
  assign sub_collections = collection.metafields.custom.sub_collections.value
  assign sub_menu = linklists[section.settings.menu]
  if sub_menu == blank
    assign menu_handle = 'sub-' | append: collection.handle
    assign sub_menu = linklists[menu_handle]
  endif

  assign has_metafield = false
  if sub_collections != blank
    assign has_metafield = true
  endif

  assign has_menu = false
  if sub_menu != blank and sub_menu.links.size > 0
    assign has_menu = true
  endif
-%}

{%- if has_metafield or has_menu -%}
  {%- style -%}
    .s24-subcol-{{ section.id }} {
      padding-top: {{ section.settings.padding_top | times: 0.75 | round }}px;
      padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round }}px;
    }
    @media screen and (min-width: 750px) {
      .s24-subcol-{{ section.id }} {
        padding-top: {{ section.settings.padding_top }}px;
        padding-bottom: {{ section.settings.padding_bottom }}px;
      }
    }
  {%- endstyle -%}

  <section class="s24-subcol s24-subcol-{{ section.id }}">
    <div class="page-width">
      {%- if section.settings.heading != blank -%}
        <div class="s24-subcol__head">
          <h2 class="s24-subcol__title">{{ section.settings.heading | escape }}</h2>
          {%- if section.settings.text != blank -%}
            <p class="s24-subcol__text">{{ section.settings.text | escape }}</p>
          {%- endif -%}
        </div>
      {%- endif -%}

      <ul class="s24-subcol__grid" role="list">
        {%- if has_metafield -%}
          {%- for child in sub_collections -%}
            {%- if child != blank -%}
              <li class="s24-subcol__item">
                <a class="s24-subcol__card" href="{{ child.url }}">
                  <span class="s24-subcol__media">
                    {%- if child.featured_image != blank -%}
                      {{
                        child.featured_image
                        | image_url: width: 800
                        | image_tag:
                          loading: 'lazy',
                          widths: '200, 400, 600, 800',
                          sizes: '(min-width: 990px) 20vw, (min-width: 750px) 30vw, 45vw',
                          alt: child.title
                      }}
                    {%- elsif child.products.first and child.products.first.featured_media -%}
                      {{
                        child.products.first.featured_media
                        | image_url: width: 800
                        | image_tag:
                          loading: 'lazy',
                          widths: '200, 400, 600, 800',
                          sizes: '(min-width: 990px) 20vw, (min-width: 750px) 30vw, 45vw',
                          alt: child.title
                      }}
                    {%- else -%}
                      {{ 'collection-1' | placeholder_svg_tag: 'placeholder-svg' }}
                    {%- endif -%}
                  </span>
                  <span class="s24-subcol__name">{{ child.title | escape }}</span>
                  {%- if section.settings.show_count -%}
                    <span class="s24-subcol__count">
                      {{ child.products_count }}
                      {% if child.products_count == 1 %}item{% else %}items{% endif %}
                    </span>
                  {%- endif -%}
                </a>
              </li>
            {%- endif -%}
          {%- endfor -%}
        {%- else -%}
          {%- for link in sub_menu.links -%}
            {%- assign child = link.object -%}
            <li class="s24-subcol__item">
              <a class="s24-subcol__card" href="{{ link.url }}">
                <span class="s24-subcol__media">
                  {%- if child != blank and child.featured_image != blank -%}
                    {{
                      child.featured_image
                      | image_url: width: 800
                      | image_tag:
                        loading: 'lazy',
                        widths: '200, 400, 600, 800',
                        sizes: '(min-width: 990px) 20vw, (min-width: 750px) 30vw, 45vw',
                        alt: link.title
                    }}
                  {%- elsif child != blank and child.products.first and child.products.first.featured_media -%}
                    {{
                      child.products.first.featured_media
                      | image_url: width: 800
                      | image_tag:
                        loading: 'lazy',
                        widths: '200, 400, 600, 800',
                        sizes: '(min-width: 990px) 20vw, (min-width: 750px) 30vw, 45vw',
                        alt: link.title
                    }}
                  {%- else -%}
                    {{ 'collection-1' | placeholder_svg_tag: 'placeholder-svg' }}
                  {%- endif -%}
                </span>
                <span class="s24-subcol__name">{{ link.title | escape }}</span>
                {%- if section.settings.show_count and child != blank -%}
                  <span class="s24-subcol__count">
                    {{ child.products_count }}
                    {% if child.products_count == 1 %}item{% else %}items{% endif %}
                  </span>
                {%- endif -%}
              </a>
            </li>
          {%- endfor -%}
        {%- endif -%}
      </ul>
    </div>
  </section>
{%- elsif request.design_mode -%}
  <section class="s24-subcol s24-subcol--empty page-width">
    <p class="s24-subcol__hint">
      Sub-collections: add metafield <code>custom.sub_collections</code> on this collection,
      or create a navigation menu with handle <code>sub-{{ collection.handle }}</code>.
    </p>
  </section>
{%- endif -%}

{% schema %}
{
  "name": "S24 sub-collections",
  "tag": "section",
  "class": "section",
  "enabled_on": { "templates": ["collection"] },
  "settings": [
    {
      "type": "paragraph",
      "content": "Shows child collections for this parent. Use metafield custom.sub_collections (list of collections), or a menu handle sub-{collection-handle}."
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Shop by category"
    },
    {
      "type": "textarea",
      "id": "text",
      "label": "Text"
    },
    {
      "type": "link_list",
      "id": "menu",
      "label": "Override menu",
      "info": "Optional. If empty, uses menu handle sub-{collection-handle}, or the collection metafield."
    },
    {
      "type": "checkbox",
      "id": "show_count",
      "label": "Show product count",
      "default": true
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Padding top",
      "default": 24
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Padding bottom",
      "default": 8
    }
  ],
  "presets": [{ "name": "S24 sub-collections" }]
}
{% endschema %}
