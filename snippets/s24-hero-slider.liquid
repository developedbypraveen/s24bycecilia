{% comment %}
  Homepage 50/50 hero slider fallback. Live homepage uses the S24 hero section.
{% endcomment %}
{%- if request.page_type == 'index' -%}
<section class="s24-hero s24-hero--slider" data-s24-hero data-interval="6000">
  <article class="s24-hero__slide is-active" data-s24-hero-slide>
    <div class="s24-hero__copy">
      <p class="s24-hero__kicker">The new collection</p>
      <h1 class="s24-hero__title">African luxury,<br>worn with grace.</h1>
      <div class="s24-hero__actions">
        <a class="s24-btn" href="{{ routes.all_products_collection_url }}">Shop the collection</a>
      </div>
    </div>
    <div class="s24-hero__media">
      <img
        src="https://cdn.shopify.com/s/files/1/0871/2005/2417/files/two-piece-african-print-geometric-lifestyle-01.jpg"
        alt="African luxury, worn with grace"
        width="1800"
        height="1800"
        loading="eager"
      >
      <span class="s24-hero__watermark">Cecilia</span>
    </div>
  </article>
</section>
{%- endif -%}
